# Server-only PostgreSQL connection string for Supabase.
# Prefer the Session pooler connection string for IPv4-only environments.
SUPABASE_DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres?sslmode=require

# Cloudflare Radar API token. Never expose this to the frontend.
CF_API_TOKEN=

# Radar refresh interval in seconds. A refresh creates a new observation.
RADAR_REFRESH_SECONDS=21600
RADAR_TIMEOUT_SECONDS=15
RADAR_ATTACKS_LIMIT=100
RADAR_LOCATIONS_LIMIT=50
RADAR_DATE_RANGE=1d
RADAR_HISTORY_DATE_RANGE=7d
RADAR_HISTORY_AGG_INTERVAL=1h

# Radar pulse heartbeat (seconds) and max routes per layer pushed over
# the WebSocket radar_pulse message.
RADAR_PULSE_INTERVAL_SECONDS=30
RADAR_PULSE_MAX_ROUTES=30

# Threat-intel feeds (abuse.ch). All optional except Feodo/URLhaus which
# need no auth; ThreatFox skips itself silently when its key is unset.
THREAT_FOX_AUTH=
GREYNOISE_COMM_KEY=

# MaxMind GeoLite2 City database used to geolocate indicators.
# Download manually (account required) to ./data/GeoLite2-City.mmdb.
MAXMIND_KEY=
MAXMIND_CITY_DB_PATH=./data/GeoLite2-City.mmdb

# Threat-intel ingest cadence (seconds) and retention.
THREATINTEL_POLL_URLHAUS_SECONDS=300
THREATINTEL_POLL_FEODO_SECONDS=1800
THREATINTEL_POLL_THREATFOX_SECONDS=300
THREATINTEL_PRUNE_AFTER_DAYS=7
THREATINTEL_PRUNE_INTERVAL_SECONDS=3600
THREATINTEL_GREYNOISE_ENRICHMENT_TOP_N=20
THREATINTEL_MAX_INDICATORS_PER_FEED=200
THREATINTEL_HTTP_TIMEOUT_SECONDS=20

# Allowed CORS origins (JSON array).
CORS_ORIGINS=["http://localhost:3000"]
