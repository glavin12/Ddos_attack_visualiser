# Server-only PostgreSQL connection string for Supabase.
# Prefer the Session pooler connection string for IPv4-only environments.
SUPABASE_DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres?sslmode=require

# Cloudflare Radar API token. Never expose this to the frontend.
CF_API_TOKEN=

# Radar refresh interval in seconds. A refresh creates a new observation.
RADAR_REFRESH_SECONDS=300
RADAR_TIMEOUT_SECONDS=15
RADAR_ATTACKS_LIMIT=100
RADAR_LOCATIONS_LIMIT=50
RADAR_DATE_RANGE=1d
RADAR_HISTORY_DATE_RANGE=7d
RADAR_HISTORY_AGG_INTERVAL=1h

# Simulation / WebSocket timing (milliseconds).
WS_EVENT_INTERVAL_MS=250
AMBIENT_EVENT_INTERVAL_MS=1000
MAX_ACTIVE_EVENTS=50
EVENT_LIFETIME_MS=4000

# Allowed CORS origins (JSON array).
CORS_ORIGINS=["http://localhost:3000"]
