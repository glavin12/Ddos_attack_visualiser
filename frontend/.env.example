# Frontend env — copy to .env.local for local dev, or set these in Vercel
# (Project → Settings → Environment Variables). Only NEXT_PUBLIC_* values are
# shipped to the browser; never put backend secrets here.

# Base HTTP endpoint of the backend API (include the /api/v1 suffix).
# Local:  http://localhost:8000/api/v1
# Prod:   https://<your-render-service>.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# WebSocket stream endpoint. Use wss:// against the deployed (HTTPS) backend.
# Local:  ws://localhost:8000/api/v1/ws/radar
# Prod:   wss://<your-render-service>.onrender.com/api/v1/ws/radar
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws/radar

# Canonical site URL used for metadata (Open Graph). Set to your Vercel URL.
# Local:  http://localhost:3000
# Prod:   https://<your-app>.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
